#!/usr/bin/env node
// scripts/test — repository test entrypoint for automated check runs.
//
// Runs the repository's build-free parity suite in a plain Linux container
// (node, python3, network; no GPU, no Qt toolchain):
//   - the three pure-node byte gates against the pinned reference checkout
//     (SHADERS, DEFINITIONS, EFFECTS_UI — the effect-catalog parity gates)
//   - the fixture-coverage record check (parity/effect-fixture-coverage.json must
//     equal its regeneration against the pinned reference; tools/fixture-coverage.mjs)
//   - the parity unit suites (test_artistic_matrix, test_harness_contract)
// The reference checkout must be at PIN: a checkout whose HEAD is another
// commit (NM_REFERENCE_ROOT, NM_TEST_REFERENCE or the default cache) stops the
// run before any gate, and the error names HEAD and PIN.
// The C++/ctest layer needs a Qt + GL 4.1 toolchain and is not attempted
// here. The parity unit suites run with python3 -m unittest, so no pip
// install is required; the run prints the test count.
// Exits nonzero on any failure.

import { spawnSync } from 'node:child_process'
import { existsSync, mkdirSync, rmSync } from 'node:fs'
import { join, resolve } from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = resolve(fileURLToPath(import.meta.url), '..', '..')
// The reference (noisemaker) commit this port is synced to. CI and scripts/parity-summary
// read it from this line.
const PIN = '668b82ea1f7b7568610b1fb1058444d61b6e330f'

function run(cmd, args, opts = {}) {
    const r = spawnSync(cmd, args, { stdio: 'inherit', cwd: ROOT, ...opts })
    if (r.status !== 0) {
        console.error(`FAIL: ${cmd} ${args.join(' ')} (exit ${r.status ?? r.signal})`)
        process.exit(1)
    }
}

function referenceHead(root) {
    const r = spawnSync('git', ['-C', root, 'rev-parse', '--verify', 'HEAD^{commit}'], { encoding: 'utf8' })
    return r.status === 0 ? r.stdout.trim() : null
}

// Every gate below measures the port against the reference checkout, so the
// checkout must be at PIN. A checkout at any other commit stops the run here.
let referenceRoot = process.env.NM_REFERENCE_ROOT
let referenceSource = 'NM_REFERENCE_ROOT'
if (!referenceRoot) {
    referenceSource = process.env.NM_TEST_REFERENCE ? 'NM_TEST_REFERENCE' : null
    referenceRoot = process.env.NM_TEST_REFERENCE
        || join(process.env.TMPDIR || '/tmp', `noisemaker-reference-${PIN.slice(0, 12)}`)
    if (!existsSync(join(referenceRoot, 'shaders', 'src'))) {
        rmSync(referenceRoot, { recursive: true, force: true })
        mkdirSync(referenceRoot, { recursive: true })
        run('git', ['clone', '--quiet', 'https://github.com/noisefactorllc/noisemaker.git', referenceRoot])
        run('git', ['-C', referenceRoot, 'checkout', '--quiet', PIN])
    } else if (!referenceSource && referenceHead(referenceRoot) !== PIN) {
        // This script owns the default checkout: move it to the pin.
        run('git', ['-C', referenceRoot, 'checkout', '--quiet', PIN])
    }
}
const head = referenceHead(referenceRoot)
if (head !== PIN) {
    console.error(`${referenceSource ?? 'reference'} checkout at ${referenceRoot} is at HEAD ${head ?? '(no git revision)'}, not at PIN ${PIN}`)
    process.exit(1)
}
console.log(`reference checkout: ${referenceRoot} (HEAD ${head})`)

const env = { ...process.env, NM_REFERENCE_ROOT: referenceRoot }
for (const gate of [
    'parity/check_shaders.mjs',
    'parity/check_definitions.mjs',
    'parity/check_effects_ui.mjs',
]) run('node', [gate], { env })
run('node', ['tools/fixture-coverage.mjs', '--check', '--reference-commit', PIN], { env })
run('python3', ['-m', 'unittest', '-v', 'parity.test_artistic_matrix', 'parity.test_harness_contract'])
console.log('scripts/test: all parity checks passed')
